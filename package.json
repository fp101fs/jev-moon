    "replay": "bun src/replay.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "backtest": "bun src/backtest.ts",
    "candles": "bun src/candle-backtest.ts",
    "bot": "bun src/bot.ts",
    "bot:status": "bun src/bot.ts status",
    "daily": "bun src/daily.ts",
    "walkforward": "bun src/walkforward.ts",
    "allocation": "bun src/allocation.ts",
    "combined": "bun src/combined.ts",
    "dip-reentry": "bun src/dip-reentry.ts",
    "test-ideas": "bun src/test-all-ideas.ts",
    "compare": "bun src/compare-core-variants.ts",
    "test-new-ideas": "bun src/test-5-new-ideas.ts",
    "chart": "bun src/chart-server.ts",
