{
  "name": "jev-market-reflex",
  "version": "0.1.0",
  "description": "Fast typed AI decisions on live crypto markets, with paper-only execution and offline replay.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "jev",
    "typesafe-ai",
    "ai-agents",
    "crypto",
    "algorithmic-trading",
